<?xml version="1.0" encoding="UTF-8"?>
<!-- Практикум «Справочника СА»: одно из возможных решений упражнения «BPMN процесса Leaver» по кейсу IDM-JOINER.
     В документации кейса процесса Leaver нет (волна 2) — это учебное решение. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Leaver" targetNamespace="http://sa-handbook.local/bpmn">
  <bpmn:collaboration id="Collab_Leaver">
    <bpmn:participant id="P_Leaver" name="Leaver: отзыв доступов при увольнении" processRef="Process_Leaver" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Leaver" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L_HR" name="HR-специалист"><bpmn:flowNodeRef>S</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_IDM" name="IdM (автоматически)">
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>TM</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BLOCK</bpmn:flowNodeRef><bpmn:flowNodeRef>T_MAIL</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MGR" name="Руководитель"><bpmn:flowNodeRef>T_MGR</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Приказ об увольнении проведён"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="Срочное увольнение?"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F_YES</bpmn:outgoing><bpmn:outgoing>F_NO</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="TM" name="Конец последнего рабочего дня">
      <bpmn:incoming>F_NO</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TMD" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G2"><bpmn:incoming>F_YES</bpmn:incoming><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_BLOCK" name="Заблокировать учётные записи, отозвать полномочия"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="T_MAIL" name="Предоставить руководителю доступ к почтовому ящику"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T_MGR" name="Забрать нужные данные из ящика"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E" name="Доступы отозваны"><bpmn:incoming>F6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="G1" />
    <bpmn:sequenceFlow id="F_YES" name="Да" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="F_NO" name="Нет" sourceRef="G1" targetRef="TM" />
    <bpmn:sequenceFlow id="F2" sourceRef="TM" targetRef="G2" />
    <bpmn:sequenceFlow id="F3" sourceRef="G2" targetRef="T_BLOCK" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_BLOCK" targetRef="T_MAIL" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_MAIL" targetRef="T_MGR" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_MGR" targetRef="E" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_Leaver">
    <bpmndi:BPMNPlane id="PL_Leaver" bpmnElement="Collab_Leaver">
      <bpmndi:BPMNShape id="P_di" bpmnElement="P_Leaver" isHorizontal="true"><dc:Bounds x="120" y="60" width="980" height="440" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_HR_di" bpmnElement="L_HR" isHorizontal="true"><dc:Bounds x="150" y="60" width="950" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_IDM_di" bpmnElement="L_IDM" isHorizontal="true"><dc:Bounds x="150" y="180" width="950" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_MGR_di" bpmnElement="L_MGR" isHorizontal="true"><dc:Bounds x="150" y="380" width="950" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="202" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="176" y="142" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="295" y="255" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="350" y="236" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TM_di" bpmnElement="TM"><dc:Bounds x="442" y="322" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="410" y="358" width="100" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="555" y="255" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_BLOCK_di" bpmnElement="T_BLOCK"><dc:Bounds x="650" y="240" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_MAIL_di" bpmnElement="T_MAIL"><dc:Bounds x="810" y="240" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_MGR_di" bpmnElement="T_MGR"><dc:Bounds x="810" y="400" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="992" y="422" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="970" y="460" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="238" y="120" /><di:waypoint x="320" y="120" /><di:waypoint x="320" y="255" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_YES_di" bpmnElement="F_YES"><di:waypoint x="345" y="280" /><di:waypoint x="555" y="280" /><bpmndi:BPMNLabel><dc:Bounds x="440" y="262" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_NO_di" bpmnElement="F_NO"><di:waypoint x="320" y="305" /><di:waypoint x="320" y="340" /><di:waypoint x="442" y="340" /><bpmndi:BPMNLabel><dc:Bounds x="326" y="314" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="478" y="340" /><di:waypoint x="580" y="340" /><di:waypoint x="580" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="605" y="280" /><di:waypoint x="650" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="760" y="280" /><di:waypoint x="810" y="280" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="865" y="320" /><di:waypoint x="865" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="920" y="440" /><di:waypoint x="992" y="440" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
