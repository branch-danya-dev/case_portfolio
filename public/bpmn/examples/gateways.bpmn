<?xml version="1.0" encoding="UTF-8"?>
<!-- Учебный пример «Справочника СА»: XOR-ветвление и слияние, AND-ветвление и синхронизация.
     Сюжет — упрощённый фрагмент UC-04 кейса IDM-JOINER (согласование дополнительного полномочия). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_Gateways" targetNamespace="http://sa-handbook.local/bpmn">
  <bpmn:process id="Process_Gateways" name="Согласовать полномочие" isExecutable="false">
    <bpmn:startEvent id="Start" name="Заявка подана">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Check" name="Проверить заявку">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="XorSplit" name="Полномочие критичное?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AndSplit">
      <bpmn:incoming>F_Yes</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Owner" name="Согласовать с владельцем ресурса">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Sec" name="Согласовать с ИБ">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="AndJoin">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="XorJoin">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F_No</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Grant" name="Выдать полномочие">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Полномочие выдано">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Check" />
    <bpmn:sequenceFlow id="F2" sourceRef="Check" targetRef="XorSplit" />
    <bpmn:sequenceFlow id="F_Yes" name="Да" sourceRef="XorSplit" targetRef="AndSplit" />
    <bpmn:sequenceFlow id="F_No" name="Нет" sourceRef="XorSplit" targetRef="XorJoin" />
    <bpmn:sequenceFlow id="F3" sourceRef="AndSplit" targetRef="Owner" />
    <bpmn:sequenceFlow id="F4" sourceRef="AndSplit" targetRef="Sec" />
    <bpmn:sequenceFlow id="F5" sourceRef="Owner" targetRef="AndJoin" />
    <bpmn:sequenceFlow id="F6" sourceRef="Sec" targetRef="AndJoin" />
    <bpmn:sequenceFlow id="F7" sourceRef="AndJoin" targetRef="XorJoin" />
    <bpmn:sequenceFlow id="F8" sourceRef="XorJoin" targetRef="Grant" />
    <bpmn:sequenceFlow id="F9" sourceRef="Grant" targetRef="End" />
    <bpmn:textAnnotation id="Ann_And">
      <bpmn:text>AND: оба согласования идут одновременно; слияние ждёт оба</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_And" sourceRef="AndJoin" targetRef="Ann_And" />
    <bpmn:textAnnotation id="Ann_Xor">
      <bpmn:text>XOR-слияние пропускает первый пришедший токен: активна только одна ветка</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Xor" sourceRef="XorJoin" targetRef="Ann_Xor" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Gateways">
    <bpmndi:BPMNPlane id="Plane_Gateways" bpmnElement="Process_Gateways">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="133" y="325" width="74" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="240" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XorSplit_di" bpmnElement="XorSplit" isMarkerVisible="true">
        <dc:Bounds x="395" y="275" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="377" y="332" width="86" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AndSplit_di" bpmnElement="AndSplit">
        <dc:Bounds x="495" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Owner_di" bpmnElement="Owner">
        <dc:Bounds x="600" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sec_di" bpmnElement="Sec">
        <dc:Bounds x="600" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AndJoin_di" bpmnElement="AndJoin">
        <dc:Bounds x="755" y="135" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="XorJoin_di" bpmnElement="XorJoin" isMarkerVisible="true">
        <dc:Bounds x="875" y="275" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Grant_di" bpmnElement="Grant">
        <dc:Bounds x="980" y="260" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1144" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1126" y="325" width="72" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_And_di" bpmnElement="Ann_And">
        <dc:Bounds x="840" y="30" width="180" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Xor_di" bpmnElement="Ann_Xor">
        <dc:Bounds x="800" y="380" width="220" height="54" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="188" y="300" /><di:waypoint x="240" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="340" y="300" /><di:waypoint x="395" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Yes_di" bpmnElement="F_Yes">
        <di:waypoint x="420" y="275" /><di:waypoint x="420" y="160" /><di:waypoint x="495" y="160" />
        <bpmndi:BPMNLabel><dc:Bounds x="426" y="214" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_No_di" bpmnElement="F_No">
        <di:waypoint x="445" y="300" /><di:waypoint x="875" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="640" y="304" width="22" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="520" y="135" /><di:waypoint x="520" y="90" /><di:waypoint x="600" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="520" y="185" /><di:waypoint x="520" y="230" /><di:waypoint x="600" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="700" y="90" /><di:waypoint x="780" y="90" /><di:waypoint x="780" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="700" y="230" /><di:waypoint x="780" y="230" /><di:waypoint x="780" y="185" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="805" y="160" /><di:waypoint x="900" y="160" /><di:waypoint x="900" y="275" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="925" y="300" /><di:waypoint x="980" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1080" y="300" /><di:waypoint x="1144" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_And_di" bpmnElement="Assoc_And">
        <di:waypoint x="796" y="151" /><di:waypoint x="850" y="84" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_Xor_di" bpmnElement="Assoc_Xor">
        <di:waypoint x="900" y="325" /><di:waypoint x="900" y="380" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
