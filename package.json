{
  "name": "sa-handbook",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:assets && astro dev",
    "build": "npm run prepare:assets && astro build && node scripts/check-offline.mjs",
    "preview": "astro preview",
