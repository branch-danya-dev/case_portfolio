---
/**
 * Символы нотации BPMN 2.0 для таблиц (inline SVG, цвет = цвет текста, работает в обеих темах и при печати).
 * Начертание упрощено, но соответствует нотации: толщина обводки событий, маркеры шлюзов, вид стрелок.
 */
export type BpmnSymbolName =
  | 'start'
  | 'intermediate'
  | 'end'
  | 'timer'
  | 'message-catch'
  | 'message-throw'
  | 'error-end'
  | 'terminate-end'
  | 'boundary'
  | 'task'
  | 'user-task'
  | 'service-task'
  | 'subprocess'
  | 'call-activity'
  | 'xor'
  | 'and'
  | 'or'
  | 'event-based'
  | 'sequence-flow'
  | 'default-flow'
  | 'conditional-flow'
  | 'message-flow'
  | 'association'
  | 'pool'
  | 'data-object'
  | 'data-store'
  | 'annotation';

interface Props {
  name: BpmnSymbolName;
  /** Подпись для скринридеров. */
  label: string;
}
const { name, label } = Astro.props;
const S = 'currentColor';
---

<svg class="notation-symbol" viewBox="0 0 72 48" role="img" aria-label={label} fill="none" stroke={S} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  <title>{label}</title>
  {name === 'start' && <circle cx="36" cy="24" r="14" stroke-width="1.5" />}
  {
    name === 'intermediate' && (
      <>
        <circle cx="36" cy="24" r="14" />
        <circle cx="36" cy="24" r="11" />
      </>
    )
  }
  {name === 'end' && <circle cx="36" cy="24" r="13" stroke-width="4" />}
  {
    name === 'timer' && (
      <>
        <circle cx="36" cy="24" r="16" />
        <circle cx="36" cy="24" r="13" />
        <circle cx="36" cy="24" r="8.5" />
        <path d="M36 24V18.5M36 24l4 2.5" />
      </>
    )
  }
  {
    name === 'message-catch' && (
      <>
        <circle cx="36" cy="24" r="16" />
        <circle cx="36" cy="24" r="13" />
        <rect x="29" y="19.5" width="14" height="9.5" />
        <path d="M29 19.5l7 5 7-5" />
      </>
    )
  }
  {
    name === 'message-throw' && (
      <>
        <circle cx="36" cy="24" r="16" />
        <circle cx="36" cy="24" r="13" />
        <rect x="29" y="19.5" width="14" height="9.5" fill={S} />
        <path d="M29 19.5l7 5 7-5" stroke="var(--sl-color-black, #fff)" />
      </>
    )
  }
  {
    name === 'error-end' && (
      <>
        <circle cx="36" cy="24" r="15" stroke-width="4" />
        <path d="M29 31l3.5-11 4 6 4.5-10-2 13-4.5-6z" fill={S} stroke-width="1" />
      </>
    )
  }
  {
    name === 'terminate-end' && (
      <>
        <circle cx="36" cy="24" r="15" stroke-width="4" />
        <circle cx="36" cy="24" r="8.5" fill={S} />
      </>
    )
  }
  {
    name === 'boundary' && (
      <>
        <rect x="6" y="4" width="60" height="34" rx="6" />
        <circle cx="50" cy="38" r="8" fill="var(--sl-color-black, #fff)" />
        <circle cx="50" cy="38" r="5.8" />
        <circle cx="50" cy="38" r="3" />
        <path d="M50 38v-2M50 38l1.5 1" stroke-width="1" />
      </>
    )
  }
  {name === 'task' && <rect x="6" y="6" width="60" height="36" rx="6" />}
  {
    name === 'user-task' && (
      <>
        <rect x="6" y="6" width="60" height="36" rx="6" />
        <circle cx="16" cy="14" r="3" />
        <path d="M10.5 22.5c0-3.5 2.5-5.5 5.5-5.5s5.5 2 5.5 5.5z" />
      </>
    )
  }
  {
    name === 'service-task' && (
      <>
        <rect x="6" y="6" width="60" height="36" rx="6" />
        <circle cx="16" cy="16" r="2.4" />
        <path d="M16 10.5v2M16 19.5v2M10.5 16h2M19.5 16h2M12.1 12.1l1.4 1.4M18.5 18.5l1.4 1.4M12.1 19.9l1.4-1.4M18.5 13.5l1.4-1.4" />
      </>
    )
  }
  {
    name === 'subprocess' && (
      <>
        <rect x="6" y="6" width="60" height="36" rx="6" />
        <rect x="31" y="31" width="10" height="10" stroke-width="1.2" />
        <path d="M36 33v6M33 36h6" stroke-width="1.2" />
      </>
    )
  }
  {
    name === 'call-activity' && (
      <>
        <rect x="6" y="6" width="60" height="36" rx="6" stroke-width="4" />
        <rect x="31" y="30" width="10" height="10" stroke-width="1.2" />
        <path d="M36 32v6M33 35h6" stroke-width="1.2" />
      </>
    )
  }
  {
    name === 'xor' && (
      <>
        <path d="M36 4l20 20-20 20-20-20z" />
        <path d="M30 18l12 12M42 18L30 30" stroke-width="3" />
      </>
    )
  }
  {
    name === 'and' && (
      <>
        <path d="M36 4l20 20-20 20-20-20z" />
        <path d="M36 15v18M27 24h18" stroke-width="3" />
      </>
    )
  }
  {
    name === 'or' && (
      <>
        <path d="M36 4l20 20-20 20-20-20z" />
        <circle cx="36" cy="24" r="7.5" stroke-width="2.6" />
      </>
    )
  }
  {
    name === 'event-based' && (
      <>
        <path d="M36 4l20 20-20 20-20-20z" />
        <circle cx="36" cy="24" r="9" />
        <circle cx="36" cy="24" r="7" />
        <path d="M36 19.5l4.3 3.1-1.6 5h-5.4l-1.6-5z" />
      </>
    )
  }
  {
    name === 'sequence-flow' && (
      <>
        <path d="M8 24h50" />
        <path d="M56 19l9 5-9 5z" fill={S} />
      </>
    )
  }
  {
    name === 'default-flow' && (
      <>
        <path d="M8 24h50M16 19l6 10" />
        <path d="M56 19l9 5-9 5z" fill={S} />
      </>
    )
  }
  {
    name === 'conditional-flow' && (
      <>
        <path d="M8 24l6-5 6 5-6 5z" fill="var(--sl-color-black, #fff)" />
        <path d="M20 24h38" />
        <path d="M56 19l9 5-9 5z" fill={S} />
      </>
    )
  }
  {
    name === 'message-flow' && (
      <>
        <circle cx="10" cy="24" r="3.5" />
        <path d="M14 24h44" stroke-dasharray="5 4" />
        <path d="M56 19l9 5-9 5z" fill="var(--sl-color-black, #fff)" />
      </>
    )
  }
  {name === 'association' && <path d="M8 24h56" stroke-dasharray="1.5 4" stroke-width="2" />}
  {
    name === 'pool' && (
      <>
        <rect x="3" y="4" width="66" height="40" />
        <path d="M14 4v40M14 24h55" />
        <path d="M8.5 13v22" stroke-width="1" stroke-dasharray="2 2" />
      </>
    )
  }
  {
    name === 'data-object' && (
      <>
        <path d="M27 6h13l8 8v28H27z" />
        <path d="M40 6v8h8" />
      </>
    )
  }
  {
    name === 'data-store' && (
      <>
        <ellipse cx="36" cy="11" rx="15" ry="5" />
        <path d="M21 11v26c0 2.8 6.7 5 15 5s15-2.2 15-5V11" />
        <path d="M21 15.5c0 2.8 6.7 5 15 5s15-2.2 15-5" />
      </>
    )
  }
  {
    name === 'annotation' && (
      <>
        <path d="M22 6h-8v36h8" />
        <path d="M20 16h34M20 24h40M20 32h26" stroke-width="1" opacity="0.6" />
      </>
    )
  }
</svg>
