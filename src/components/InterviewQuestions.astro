---
/**
 * Вопросы на собеседовании из банка src/data/questions/<topic>.yaml.
 * Ответы спрятаны в раскрывающиеся блоки. Те же записи использует тренажёр.
 */
import { getEntry } from 'astro:content';
import { marked } from 'marked';

interface Props {
  topic: string;
  /** Показать только эти вопросы (по id) и в этом порядке. По умолчанию — все. */
  ids?: string[];
  /** Панель над списком: фильтр по уровню и «Раскрыть все» (страницы раздела «Собеседование»). */
  toolbar?: boolean;
}
const { topic, ids, toolbar = false } = Astro.props;

const entry = await getEntry('questions', topic);
if (!entry) throw new Error(`<InterviewQuestions>: нет файла src/data/questions/${topic}.yaml`);

const items = ids
  ? ids.map((id) => {
      const q = entry.data.items.find((i) => i.id === id);
      if (!q) throw new Error(`<InterviewQuestions>: в теме «${topic}» нет вопроса «${id}»`);
      return q;
    })
  : entry.data.items;

const levelLabel = { junior: 'junior', middle: 'middle', senior: 'senior' } as const;
---

{
  toolbar && (
    <div class="questions-toolbar not-content" data-questions-toolbar>
      <span class="questions-toolbar__label">Уровень:</span>
      {(['junior', 'middle', 'senior'] as const).map((l) => (
        <label>
          <input type="checkbox" value={l} checked /> {l} ({items.filter((q) => q.level === l).length})
        </label>
      ))}
      <button type="button" class="sa-btn" data-expand>Раскрыть все</button>
      <button type="button" class="sa-btn" data-collapse>Свернуть все</button>
    </div>
  )
}

<div class="questions">
  {
    items.map((q) => (
      <details class="question" id={`q-${q.id}`} data-level={q.level}>
        <summary>
          <span class="q-text">{q.question}</span>
          <span class="level-badge" data-level={q.level} title="Уровень вопроса">
            {levelLabel[q.level]}
          </span>
        </summary>
        <div class="answer" set:html={marked.parse(q.answer, { async: false })} />
      </details>
    ))
  }
</div>

<script>
  // Переход по ссылке на конкретный вопрос (#q-…, например из тренажёра) — раскрыть его.
  const openFromHash = () => {
    const el = location.hash.startsWith('#q-') ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    if (el instanceof HTMLDetailsElement) {
      el.hidden = false;
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.querySelectorAll<HTMLElement>('[data-questions-toolbar]').forEach((bar) => {
    const list = bar.nextElementSibling as HTMLElement;
    const all = [...list.querySelectorAll<HTMLDetailsElement>('details.question')];
    const boxes = [...bar.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const apply = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.value));
      for (const d of all) d.hidden = !on.has(d.dataset.level!);
    };
    boxes.forEach((b) => b.addEventListener('change', apply));
    bar.querySelector('[data-expand]')!.addEventListener('click', () => all.forEach((d) => !d.hidden && (d.open = true)));
    bar.querySelector('[data-collapse]')!.addEventListener('click', () => all.forEach((d) => (d.open = false)));
  });
</script>
