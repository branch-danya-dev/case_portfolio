      <bpmndi:BPMNEdge id="Assoc_1_di" bpmnElement="Assoc_1"><di:waypoint x="470" y="140" /><di:waypoint x="470" y="690" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Ann_P02_di" bpmnElement="Ann_P02"><dc:Bounds x="610" y="690" width="138" height="56" /></bpmndi:BPMNShape>
