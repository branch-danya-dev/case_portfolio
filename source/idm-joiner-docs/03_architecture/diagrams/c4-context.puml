@startuml c4-context
' C4, уровень 1 — контекст системы
' Библиотека C4-PlantUML входит в стандартную поставку PlantUML (stdlib)
!include <C4/C4_Context>

title Контекст системы IdM (волна 1)

Person(hr, "HR-специалист", "Оформляет приказы о приёме")
Person(mgr, "Руководитель", "Запрашивает доп. доступы, получает уведомления")
Person(sec, "Инженер ИБ", "Рассматривает SoD-конфликты, ведёт ролевую модель")
Person(adm, "Администратор", "Исполняет задачи вручную")
Person(emp, "Новый сотрудник", "Получает одноразовый пароль")
Person(aud, "Аудитор", "Проверяет основания выдачи прав")

System(idm, "IdM", "Управление идентичностями и доступами: роли, SoD, согласования, провижининг, аудит")

System_Ext(hrms, "HRMS (1С:ЗУП)", "Кадровая система — источник истины о сотрудниках")
System_Ext(bus, "Корпоративная шина (Kafka)", "Асинхронный обмен событиями")
System_Ext(ad, "Active Directory", "Учётные записи и группы домена")
System_Ext(exch, "Exchange", "Корпоративная почта")
System_Ext(abs, "АБС", "Автоматизированная банковская система")
System_Ext(sd, "ServiceDesk", "Задачи ручного исполнения")
System_Ext(sms, "SMS-шлюз", "Отправка SMS")
System_Ext(siem, "SIEM", "Мониторинг событий ИБ")

Rel(hr, hrms, "Проводит приказ")
Rel(hrms, bus, "Публикует кадровые события", "Kafka")
Rel(bus, idm, "Доставляет события", "Kafka")
Rel(idm, hrms, "Запрашивает полный срез (сверка)", "REST")
Rel(mgr, idm, "Заявки, статус", "HTTPS, портал")
Rel(sec, idm, "Решения по SoD, ролевая модель", "HTTPS, портал")
Rel(aud, idm, "Отчёты", "HTTPS, портал")
Rel(idm, ad, "Учётные записи, группы", "LDAPS")
Rel(idm, exch, "Почтовые ящики; уведомления", "PowerShell / SMTP")
Rel(idm, abs, "Пользователи и роли", "REST через адаптер")
Rel(idm, sd, "Создаёт задачи", "REST")
Rel(sd, idm, "Сообщает о закрытии задач", "REST webhook")
Rel(adm, sd, "Исполняет задачи")
Rel(idm, sms, "Одноразовый пароль", "REST")
Rel(sms, emp, "SMS")
Rel(idm, siem, "Журнал аудита", "Kafka")

SHOW_LEGEND()
@enduml
